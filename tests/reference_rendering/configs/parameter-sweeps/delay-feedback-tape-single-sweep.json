{
  "name": "Delay Feedback Sweep",
  "description": "Sweep feedback parameter from 0.0 to 0.95",
  "plugin": "delay",
  "mode": "Tape",
  "style": "Single",
  "parameter": "feedback",
  "range": [
    0.0,
    0.95
  ],
  "steps": 20,
  "scale": "linear",
  "signal_type": "impulse",
  "sample_rate": 44100,
  "duration_seconds": 5.0,
  "base_params": {
    "mix": 1.0,
    "delayTimeMs": 500.0,
    "modRate": 1.0,
    "modDepth": 0.3,
    "drive": 0.5
  },
  "notes": "Test feedback stability and echo decay"
}